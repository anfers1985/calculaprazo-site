# Página 404 — retorno HTTP 404 real
/404.html
  X-Robots-Tag: noindex, follow

# Cloudflare Pages — cabeçalhos HTTP

# ── Assets estáticos com cache longo (1 ano) ──────────────
# Dados JSON — Content-Type explícito para evitar ser interceptado pelo SPA fallback
/data/posts.json
  Content-Type: application/json; charset=utf-8
  Cache-Control: public, max-age=300, must-revalidate
  Access-Control-Allow-Origin: *

# CSS e JS externos — cache com revalidação (permite updates ao mudar ?v=N no link)
/styles.css
  Cache-Control: public, max-age=86400, must-revalidate
  Content-Type: text/css; charset=utf-8

/app.js
  Cache-Control: public, max-age=86400, must-revalidate
  Content-Type: application/javascript; charset=utf-8

/blog.js
  Cache-Control: public, max-age=86400, must-revalidate
  Content-Type: application/javascript; charset=utf-8

# Ícones PWA
/icon-192.png
  Cache-Control: public, max-age=31536000, immutable

/icon-512.png
  Cache-Control: public, max-age=31536000, immutable

/apple-touch-icon.png
  Cache-Control: public, max-age=31536000, immutable

/favicon-32x32.png
  Cache-Control: public, max-age=31536000, immutable

# ads.txt — servido como texto puro, cache curto para revalidação rápida pelo Google
/ads.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600, must-revalidate

# robots.txt
/robots.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=86400

# IndexNow — arquivo de verificação de chave
/58d04cd087698b567332e2735dbce4e7.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=86400

# sitemap.xml
/sitemap.xml
  Content-Type: application/xml; charset=utf-8
  Cache-Control: public, max-age=3600

