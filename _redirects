/calculadora-imc                   /index.html   200

# Redirect 301 — slug duplicado corrigido (deve vir antes do fallback)
/blog/fim-da-escala-6x1-ccj-da-cmara-aprova-pec-e-debate-avana-no-congresso /blog/fim-da-escala-6x1-ccj-da-camara-aprova-pec-e-debate-avanca-no-congresso 301

# Diretório /blog/ sem slug → redireciona para página de conteúdo
/blog             /#conteudo               301
/blog/            /#conteudo               301

# Blog posts (arquivos HTML reais)
/blog/*           /blog/:splat             200

# Página 404 explícita
/404              /404.html                200

# SPA fallback — todas as outras rotas vão para index.html
/*                /index.html              200
