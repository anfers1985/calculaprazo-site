# Cloudflare Pages — regras de roteamento Calcula Prazo

# Painel administrativo
/admin            /admin/index.html        200
/admin/           /admin/index.html        200

# Páginas estáticas com arquivo HTML real
/sobre            /sobre/index.html        200
/sobre/           /sobre/index.html        200
/privacidade      /privacidade/index.html  200
/privacidade/     /privacidade/index.html  200
/termos           /termos/index.html       200
/termos/          /termos/index.html       200
/contato          /contato/index.html      200
/contato/         /contato/index.html      200
# Página de Conteúdo (arquivo HTML real, desvinculado da SPA)
/conteudo         /conteudo/index.html     200
/conteudo/        /conteudo/index.html     200

# Arquivos de dados — servir diretamente ANTES do fallback SPA
/data/posts.json  /data/posts.json         200
/data/*           /data/:splat             200

# Ferramentas SPA — URLs limpas
/calculadora-de-prazo-processual   /index.html   200
/correcao-monetaria                /index.html   200
/calculadora-de-juros              /index.html   200
/calculadora-verbas-trabalhistas   /index.html   200
/calculadora-salario-liquido       /index.html   200
/calculadora-de-porcentagem        /index.html   200
/conversor-de-moedas               /index.html   200
/calculadora-de-datas              /index.html   200
/validador-cpf-cnpj                /index.html   200
/gerador-de-qr-code                /index.html   200
/gerador-de-senhas                 /index.html   200
/numero-por-extenso                /index.html   200
/calculadora-imc                   /index.html   200

# Redirect 301 — slug duplicado corrigido
/blog/fim-da-escala-6x1-ccj-da-cmara-aprova-pec-e-debate-avana-no-congresso /blog/fim-da-escala-6x1-ccj-da-camara-aprova-pec-e-debate-avanca-no-congresso 301

# Redirect 301 — arquivo duplicado com slug mal codificado (mesmo artigo já
# publicado corretamente em /blog/stf-encerra-revisao-vida-toda-inss).
# Esta versão com acentos quebrados nunca esteve no sitemap nem no
# posts.json e não tem nenhum link interno apontando para ela — era uma
# página órfã e de conteúdo 100% duplicado. Em vez de indexá-la como
# artigo novo, ela passa a redirecionar para a versão canônica.
/blog/stf-encerra-reviso-da-vida-toda-e-mantm-regra-do-inss /blog/stf-encerra-revisao-vida-toda-inss 301

# /blog redireciona para página de conteúdo real
/blog             /conteudo         301
/blog/            /conteudo         301

# Blog posts (arquivos HTML reais)
/blog/*           /blog/:splat             200

# Página 404 explícita
/404              /404.html                200

# Fallback final — qualquer URL não reconhecida pelas regras acima
# retorna a página 404 real com status HTTP 404 (evita "soft 404":
# antes, URLs inexistentes devolviam a home com status 200, o que o
# Google Search Console e o AdSense tratam como sinal de baixa qualidade).
# Todas as rotas válidas (calculadoras, blog, páginas institucionais,
# /data, /admin) já foram tratadas explicitamente acima, portanto esta
# regra só é atingida por links quebrados, slugs digitados errados ou
# páginas removidas.
/*                /404.html                404
